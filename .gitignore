# scratch pages curl 落嚟嘅外站頁面／feed（唔係 project 檔）
/*.html
!/index.html
/*.xml
/*.json
# settings.json 係用戶狀態（每次 POST 都改），唔入 git；範本用 settings.example.json
!/settings.example.json
*.tmp

# 執行 log
server_log.txt

# index.html 嘅每日 archive 副本（26MB+，可由 index.html 重生）
/archive/

# 臨時工作目錄（只保留兩階段夜報開關 enabled.json）
/scratch/*
!/scratch/pm-refresh/
/scratch/pm-refresh/*
!/scratch/pm-refresh/enabled.json

# OS/editor
Thumbs.db
.DS_Store
